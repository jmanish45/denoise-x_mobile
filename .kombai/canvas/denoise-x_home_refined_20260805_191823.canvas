      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  :root {\n    --bg: #040b14;\n    --panel: rgba(10, 23, 38, .82);\n    --panel-strong: rgba(8, 19, 33, .96);\n    --line: rgba(113, 153, 198, .18);\n    --muted: #91a3b9;\n    --soft: #6f849d;\n    --blue: #4f86ff;\n    --violet: #8758ff;\n    --teal: #15e2c2;\n    --green: #00d79b;\n  }\n  @keyframes floatLungs { 0%,100% { transform: translateY(0) scale(.99); } 50% { transform: translateY(-4px) scale(1.02); } }\n  @keyframes glowPulse { 0%,100% { opacity: .45; } 50% { opacity: .9; } }\n  @keyframes riseIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n  .rise { animation: riseIn .65s ease both; }\n  .delay-1 { animation-delay: .08s; }\n  .delay-2 { animation-delay: .18s; }\n  .delay-3 { animation-delay: .28s; }\n  .delay-4 { animation-delay: .38s; }\n  .lungs-motion { animation: floatLungs 5.5s ease-in-out infinite; }\n  .glow-motion { animation: glowPulse 3.6s ease-in-out infinite; }\n  .hide-scrollbar::-webkit-scrollbar { display: none; }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"min-h-[1040px] w-full overflow-hidden bg-[var(--bg)] text-white font-[Inter,sans-serif] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <main class=\"relative mx-auto min-h-[1040px] max-w-[375px] overflow-hidden bg-[radial-gradient(circle_at_92%_6%,rgba(31,88,153,.18),transparent_29%),linear-gradient(180deg,#061421_0%,#040b14_34%,#030a12_100%)] px-[18px] pb-[122px] pt-[14px]\" data-kid=\"1-1\" data-name=\"main content area\">\n        <div class=\"pointer-events-none absolute -right-24 top-[100px] h-[270px] w-[270px] rounded-full bg-blue-500/10 blur-3xl\" data-kid=\"1-1-1\" data-name=\"decorative blue blur orb\">\n        </div>\n        <div class=\"pointer-events-none absolute -left-28 top-[500px] h-[320px] w-[320px] rounded-full bg-cyan-400/[.035] blur-3xl\" data-kid=\"1-1-2\" data-name=\"decorative cyan blur orb\">\n        </div>\n        <header class=\"rise relative z-20 flex h-[58px] items-center justify-between\" data-kid=\"1-1-3\" data-name=\"header navigation bar\">\n            <button aria-label=\"Open menu\" class=\"grid h-11 w-11 place-items-center rounded-full text-slate-100\" data-kid=\"1-1-3-1\" data-name=\"menu hamburger button\">\n                <i class=\"h-8 w-8\" data-dynamic=\"true\" data-kid=\"1-1-3-1-1\" data-lucide=\"menu\" data-name=\"menu hamburger icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.8\">\n                </i>\n            </button>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-3-2\" data-name=\"header right actions container\">\n                <button aria-label=\"Notifications\" class=\"relative grid h-11 w-11 place-items-center text-slate-100\" data-kid=\"1-1-3-2-1\" data-name=\"notifications button\">\n                    <i class=\"h-7 w-7\" data-dynamic=\"true\" data-kid=\"1-1-3-2-1-1\" data-lucide=\"bell\" data-name=\"bell icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.8\">\n                    </i>\n                    <span class=\"absolute right-[8px] top-[6px] h-[9px] w-[9px] rounded-full border-2 border-[#061421] bg-[#655cff]\" data-kid=\"1-1-3-2-1-2\" data-name=\"notifications indicator dot\">\n                    </span>\n                </button>\n                <button aria-label=\"Open profile\" class=\"h-[46px] w-[46px] overflow-hidden rounded-full border-2 border-blue-300 shadow-[0_0_16px_rgba(79,134,255,.65)]\" data-kid=\"1-1-3-2-2\" data-name=\"profile button\">\n                    <img alt=\"Professional male doctor portrait by Usman Yousaf on Unsplash\" class=\"h-full w-full object-cover object-top\" data-kid=\"1-1-3-2-2-1\" data-name=\"user profile portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&w=240&q=80&fit=crop\"/>\n                </button>\n            </div>\n        </header>\n        <section class=\"rise delay-1 relative z-10 mt-[20px] h-[214px]\" data-kid=\"1-1-4\" data-name=\"hero greeting section\">\n            <div class=\"relative z-10 max-w-[225px] pt-[2px]\" data-kid=\"1-1-4-1\" data-name=\"hero text container\">\n                <p class=\"text-[16px] font-medium tracking-[-.2px] text-[#4f86ff]\" data-kid=\"1-1-4-1-1\" data-name=\"greeting label text\">\n                    Good Morning,\n                </p>\n                <h1 class=\"mt-[10px] text-[31px] font-semibold leading-none tracking-[-1.4px] text-slate-50\" data-kid=\"1-1-4-1-2\" data-name=\"doctor name headline\">\n                    Dr. Arjun\n                    <span class=\"text-[27px]\" data-kid=\"1-1-4-1-2-1\" data-name=\"waving hand emoji\">\n                        👋\n                    </span>\n                </h1>\n                <p class=\"mt-[25px] max-w-[205px] text-[15px] leading-[1.55] tracking-[-.2px] text-[#9bacbf]\" data-kid=\"1-1-4-1-3\" data-name=\"description text\">\n                    AI-Powered enhancement for\n                    <br data-kid=\"1-1-4-1-3-1\" data-name=\"description line break\"/>\n                    clearer, more reliable X-rays.\n                </p>\n            </div>\n            <div class=\"pointer-events-none absolute -right-[35px] -top-[16px] h-[238px] w-[245px] lungs-motion\" data-kid=\"1-1-4-2\" data-name=\"lungs animation container\">\n                <div class=\"glow-motion absolute left-[28px] top-[37px] h-[150px] w-[170px] rounded-full bg-blue-500/20 blur-3xl\" data-kid=\"1-1-4-2-1\" data-name=\"lungs glow effect\">\n                </div>\n                <img alt=\"Holographic lungs illustration\" class=\"relative z-10 h-full w-full object-contain opacity-[.88] mix-blend-screen\" data-kid=\"1-1-4-2-2\" data-name=\"holographic lungs illustration\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/lungs_hologram.png\"/>\n            </div>\n            <div class=\"pointer-events-none absolute bottom-0 right-[10px] h-[74px] w-[240px] bg-gradient-to-t from-[#040b14] via-[#040b14]/80 to-transparent\" data-kid=\"1-1-4-3\" data-name=\"hero bottom gradient mask\">\n            </div>\n        </section>\n        <section class=\"rise delay-2 relative z-10 mt-[2px]\" data-kid=\"1-1-5\" data-name=\"action section\">\n            <button aria-label=\"Upload a low-dose X-ray to Denoise-X\" class=\"group block w-full text-left\" data-kid=\"1-1-5-1\" data-name=\"upload x-ray call to action button\">\n                <div class=\"rounded-[26px] bg-gradient-to-br from-[#258bff] via-[#4b68ff] to-[#9441ff] p-[1.5px] shadow-[0_10px_34px_rgba(23,87,190,.24)]\" data-kid=\"1-1-5-1-1\" data-name=\"button border gradient wrapper\">\n                    <div class=\"relative h-[326px] overflow-hidden rounded-[24px] bg-[linear-gradient(135deg,rgba(5,16,28,.98),rgba(5,14,25,.93))] px-[25px] py-[26px]\" data-kid=\"1-1-5-1-1-1\" data-name=\"button content wrapper\">\n                        <div class=\"pointer-events-none absolute -right-12 -top-14 h-44 w-44 rounded-full bg-blue-500/10 blur-2xl\" data-kid=\"1-1-5-1-1-1-1\" data-name=\"button decorative blue blur\">\n                        </div>\n                        <div class=\"relative z-10 max-w-[250px]\" data-kid=\"1-1-5-1-1-1-2\" data-name=\"button text container\">\n                            <h2 class=\"text-[25px] font-semibold tracking-[-1px] text-slate-50\" data-kid=\"1-1-5-1-1-1-2-1\" data-name=\"upload section title\">\n                                Use\n                                <span class=\"bg-gradient-to-r from-[#4c8eff] to-[#a048ff] bg-clip-text text-transparent\" data-kid=\"1-1-5-1-1-1-2-1-1\" data-name=\"denoise-x brand text\">\n                                    Denoise-X\n                                </span>\n                            </h2>\n                            <p class=\"mt-[22px] max-w-[228px] text-[16px] leading-[1.5] text-[#a7b7c9]\" data-kid=\"1-1-5-1-1-1-2-2\" data-name=\"upload instruction text\">\n                                Upload a low-dose X-ray and let our AI enhance it for better clarity.\n                            </p>\n                            <span class=\"mt-[29px] inline-flex h-[58px] w-[205px] items-center justify-center gap-3 rounded-[17px] bg-gradient-to-r from-[#278eff] via-[#436eff] to-[#9a44ff] text-[17px] font-medium text-white shadow-[0_7px_20px_rgba(54,106,255,.35)]\" data-kid=\"1-1-5-1-1-1-2-3\" data-name=\"upload action label\">\n                                Upload X-ray\n                                <i class=\"h-6 w-6\" data-dynamic=\"true\" data-kid=\"1-1-5-1-1-1-2-3-1\" data-lucide=\"cloud-upload\" data-name=\"upload icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.8\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"absolute bottom-[27px] right-[17px] h-[193px] w-[153px] overflow-hidden rounded-[19px] border border-slate-700/70 bg-[#0b1827] shadow-[0_0_22px_rgba(31,101,175,.12)]\" data-kid=\"1-1-5-1-1-1-3\" data-name=\"x-ray preview comparison container\">\n                            <div class=\"absolute inset-0 bg-[#07111c]/35\" data-kid=\"1-1-5-1-1-1-3-1\" data-name=\"comparison darkened overlay\">\n                            </div>\n                            <img alt=\"Chest X-ray from CDC on Unsplash, before and after preview\" class=\"absolute inset-0 h-full w-full object-cover object-center grayscale contrast-125 brightness-[.86]\" data-kid=\"1-1-5-1-1-1-3-2\" data-name=\"after x-ray preview image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1631651363531-fd29aec4cb5c?auto=format&w=720&q=80&fit=crop\"/>\n                            <div class=\"absolute inset-y-0 left-0 w-1/2 overflow-hidden border-r border-white/5 bg-[#142438]/40\" data-kid=\"1-1-5-1-1-1-3-3\" data-name=\"before x-ray preview container\">\n                                <img alt=\"Chest X-ray from CDC on Unsplash, before preview\" class=\"h-full w-[306px] max-w-none object-cover object-center grayscale contrast-75 brightness-[.65]\" data-kid=\"1-1-5-1-1-1-3-3-1\" data-name=\"before x-ray preview image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1631651363531-fd29aec4cb5c?auto=format&w=720&q=80&fit=crop\"/>\n                            </div>\n                            <div class=\"absolute inset-y-0 left-1/2 w-px bg-white shadow-[0_0_8px_2px_rgba(90,167,255,.9)]\" data-kid=\"1-1-5-1-1-1-3-4\" data-name=\"comparison slider divider line\">\n                            </div>\n                            <div class=\"absolute left-1/2 top-1/2 grid h-[43px] w-[43px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-[#17304f]/95 text-white shadow-[0_0_13px_rgba(79,134,255,.8)]\" data-kid=\"1-1-5-1-1-1-3-5\" data-name=\"comparison slider handle\">\n                                <i class=\"h-5 w-5\" data-dynamic=\"true\" data-kid=\"1-1-5-1-1-1-3-5-1\" data-lucide=\"chevrons-left-right\" data-name=\"comparison slider icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.7\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </button>\n        </section>\n        <section class=\"rise delay-3 relative z-10 mt-[36px]\" data-kid=\"1-1-6\" data-name=\"statistics section\">\n            <div class=\"mb-[17px] flex items-center justify-between px-[1px]\" data-kid=\"1-1-6-1\" data-name=\"statistics section header\">\n                <h2 class=\"text-[20px] font-semibold tracking-[-.55px] text-slate-50\" data-kid=\"1-1-6-1-1\" data-name=\"statistics section title\">\n                    Quick Overview\n                </h2>\n                <button aria-label=\"See all scan statistics\" class=\"flex items-center gap-2 text-[16px] font-medium text-[#5b7dff]\" data-kid=\"1-1-6-1-2\" data-name=\"see all button\">\n                    See All\n                    <i class=\"h-5 w-5\" data-dynamic=\"true\" data-kid=\"1-1-6-1-2-1\" data-lucide=\"chevron-right\" data-name=\"see all arrow icon\" data-reason=\"icon replaced by lucide library\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"grid grid-cols-3 gap-[10px]\" data-kid=\"1-1-6-2\" data-name=\"statistics grid container\">\n                <article class=\"h-[177px] rounded-[20px] border border-[#1d3349] bg-[linear-gradient(145deg,rgba(15,32,51,.88),rgba(7,20,34,.86))] px-[12px] py-[17px] shadow-[inset_0_1px_0_rgba(255,255,255,.025)]\" data-kid=\"1-1-6-2-1\" data-name=\"total scans stat card\">\n                    <div class=\"flex items-center gap-[8px]\" data-kid=\"1-1-6-2-1-1\" data-name=\"stat card header\">\n                        <span class=\"grid h-[36px] w-[36px] shrink-0 place-items-center rounded-[11px] bg-gradient-to-br from-[#5a5cff] to-[#703bff] shadow-[0_0_15px_rgba(96,82,255,.35)]\" data-kid=\"1-1-6-2-1-1-1\" data-name=\"activity icon container\">\n                            <i class=\"h-[22px] w-[22px]\" data-dynamic=\"true\" data-kid=\"1-1-6-2-1-1-1-1\" data-lucide=\"activity\" data-name=\"activity icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"2\">\n                            </i>\n                        </span>\n                        <span class=\"text-[12px] leading-[1.1] text-[#aab9c9]\" data-kid=\"1-1-6-2-1-1-2\" data-name=\"total scans label text\">\n                            Total\n                            <br data-kid=\"1-1-6-2-1-1-2-1\" data-name=\"label line break\"/>\n                            Scans\n                        </span>\n                    </div>\n                    <p class=\"mt-[16px] text-[29px] font-medium leading-none tracking-[-1px]\" data-kid=\"1-1-6-2-1-2\" data-name=\"total scans count\">\n                        128\n                    </p>\n                    <p class=\"mt-[10px] text-[12px] font-medium text-[#00d79b]\" data-kid=\"1-1-6-2-1-3\" data-name=\"total scans growth\">\n                        +12 this week\n                    </p>\n                </article>\n                <article class=\"h-[177px] rounded-[20px] border border-[#1d3349] bg-[linear-gradient(145deg,rgba(15,32,51,.88),rgba(7,20,34,.86))] px-[12px] py-[17px] shadow-[inset_0_1px_0_rgba(255,255,255,.025)]\" data-kid=\"1-1-6-2-2\" data-name=\"enhanced scans stat card\">\n                    <div class=\"flex items-center gap-[8px]\" data-kid=\"1-1-6-2-2-1\" data-name=\"stat card header\">\n                        <span class=\"grid h-[36px] w-[36px] shrink-0 place-items-center rounded-[11px] bg-gradient-to-br from-[#0fc9bb] to-[#079f9f] shadow-[0_0_15px_rgba(0,212,170,.3)]\" data-kid=\"1-1-6-2-2-1-1\" data-name=\"check icon container\">\n                            <i class=\"h-[22px] w-[22px]\" data-dynamic=\"true\" data-kid=\"1-1-6-2-2-1-1-1\" data-lucide=\"circle-check\" data-name=\"check icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"2\">\n                            </i>\n                        </span>\n                        <span class=\"text-[12px] leading-[1.1] text-[#aab9c9]\" data-kid=\"1-1-6-2-2-1-2\" data-name=\"enhanced scans label\">\n                            Enhanced\n                        </span>\n                    </div>\n                    <p class=\"mt-[16px] text-[29px] font-medium leading-none tracking-[-1px]\" data-kid=\"1-1-6-2-2-2\" data-name=\"enhanced scans count\">\n                        115\n                    </p>\n                    <p class=\"mt-[10px] text-[12px] font-medium text-[#00d79b]\" data-kid=\"1-1-6-2-2-3\" data-name=\"enhanced success rate\">\n                        89.8% success\n                    </p>\n                </article>\n                <article class=\"h-[177px] rounded-[20px] border border-[#1d3349] bg-[linear-gradient(145deg,rgba(15,32,51,.88),rgba(7,20,34,.86))] px-[12px] py-[17px] shadow-[inset_0_1px_0_rgba(255,255,255,.025)]\" data-kid=\"1-1-6-2-3\" data-name=\"time saved stat card\">\n                    <div class=\"flex items-center gap-[8px]\" data-kid=\"1-1-6-2-3-1\" data-name=\"stat card header\">\n                        <span class=\"grid h-[36px] w-[36px] shrink-0 place-items-center rounded-[11px] bg-gradient-to-br from-[#ffb515] to-[#e99100] shadow-[0_0_15px_rgba(245,158,11,.28)]\" data-kid=\"1-1-6-2-3-1-1\" data-name=\"clock icon container\">\n                            <i class=\"h-[22px] w-[22px]\" data-dynamic=\"true\" data-kid=\"1-1-6-2-3-1-1-1\" data-lucide=\"clock-3\" data-name=\"clock icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"2\">\n                            </i>\n                        </span>\n                        <span class=\"text-[12px] leading-[1.1] text-[#aab9c9]\" data-kid=\"1-1-6-2-3-1-2\" data-name=\"time saved label\">\n                            Time Saved\n                        </span>\n                    </div>\n                    <p class=\"mt-[16px] whitespace-nowrap text-[25px] font-medium leading-none tracking-[-1px]\" data-kid=\"1-1-6-2-3-2\" data-name=\"time saved amount\">\n                        18.6\n                        <span class=\"text-[15px]\" data-kid=\"1-1-6-2-3-2-1\" data-name=\"time units text\">\n                            hrs\n                        </span>\n                    </p>\n                    <p class=\"mt-[10px] text-[12px] font-medium text-[#93a5b9]\" data-kid=\"1-1-6-2-3-3\" data-name=\"time period label\">\n                        This month\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section class=\"rise delay-4 relative z-10 mt-[43px]\" data-kid=\"1-1-7\" data-name=\"recent enhancements section\">\n            <h2 class=\"mb-[17px] px-[1px] text-[20px] font-semibold tracking-[-.55px] text-slate-50\" data-kid=\"1-1-7-1\" data-name=\"section title\">\n                Recent Enhancements\n            </h2>\n            <article class=\"relative flex h-[157px] items-center gap-[13px] rounded-[23px] border border-[#203850] bg-[linear-gradient(145deg,rgba(14,30,49,.92),rgba(7,18,31,.9))] px-[12px] py-[12px] shadow-[inset_0_1px_0_rgba(255,255,255,.025)]\" data-kid=\"1-1-7-2\" data-name=\"enhancement item card\">\n                <div class=\"relative h-[119px] w-[153px] shrink-0 overflow-hidden rounded-[16px] border border-slate-700/70 bg-[#0a1726]\" data-kid=\"1-1-7-2-1\" data-name=\"x-ray thumbnail container\">\n                    <img alt=\"Chest X-ray thumbnail from CDC on Unsplash\" class=\"h-full w-full object-cover grayscale contrast-125 brightness-[.84]\" data-kid=\"1-1-7-2-1-1\" data-name=\"x-ray thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1631651363531-fd29aec4cb5c?auto=format&w=720&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-y-0 left-1/2 w-px bg-[#6ec1ff] shadow-[0_0_7px_2px_rgba(79,134,255,.8)]\" data-kid=\"1-1-7-2-1-2\" data-name=\"thumbnail comparison divider\">\n                    </div>\n                    <div class=\"absolute bottom-[-1px] left-1/2 grid h-[35px] w-[35px] -translate-x-1/2 translate-y-1/2 place-items-center rounded-full border-2 border-[#5b96ff] bg-[#183a73] text-white shadow-[0_0_10px_rgba(79,134,255,.8)]\" data-kid=\"1-1-7-2-1-3\" data-name=\"comparison slider handle\">\n                        <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-1-7-2-1-3-1\" data-lucide=\"chevrons-left-right\" data-name=\"comparison slider icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.8\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"min-w-0 flex-1 self-stretch py-[6px]\" data-kid=\"1-1-7-2-2\" data-name=\"card details container\">\n                    <h3 class=\"truncate text-[18px] font-medium tracking-[-.4px] text-white\" data-kid=\"1-1-7-2-2-1\" data-name=\"enhancement title\">\n                        Chest X-ray\n                    </h3>\n                    <div class=\"mt-[14px] flex items-center gap-[6px] whitespace-nowrap text-[12px] text-[#9aadc3]\" data-kid=\"1-1-7-2-2-2\" data-name=\"timestamp container\">\n                        <i class=\"h-[15px] w-[15px]\" data-dynamic=\"true\" data-kid=\"1-1-7-2-2-2-1\" data-lucide=\"calendar-days\" data-name=\"calendar icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.8\">\n                        </i>\n                        <span data-kid=\"1-1-7-2-2-2-2\" data-name=\"timestamp text\">\n                            May 24, 2025 · 10:30 AM\n                        </span>\n                    </div>\n                    <div class=\"mt-[15px] flex items-center gap-[6px] whitespace-nowrap text-[12px] font-medium text-[#00d79b]\" data-kid=\"1-1-7-2-2-3\" data-name=\"status container\">\n                        <i class=\"h-[15px] w-[15px]\" data-dynamic=\"true\" data-kid=\"1-1-7-2-2-3-1\" data-lucide=\"circle-check\" data-name=\"success check icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"2\">\n                        </i>\n                        <span data-kid=\"1-1-7-2-2-3-2\" data-name=\"status text\">\n                            Enhancement Completed\n                        </span>\n                    </div>\n                </div>\n                <button aria-label=\"More options for Chest X-ray\" class=\"absolute right-[10px] top-[13px] text-[#8aa0ba]\" data-kid=\"1-1-7-2-3\" data-name=\"more options button\">\n                    <i class=\"h-5 w-5\" data-dynamic=\"true\" data-kid=\"1-1-7-2-3-1\" data-lucide=\"more-vertical\" data-name=\"more options icon\" data-reason=\"icon replaced by lucide library\">\n                    </i>\n                </button>\n                <button aria-label=\"View Chest X-ray\" class=\"absolute bottom-[22px] right-[11px] h-[47px] w-[84px] rounded-[17px] border border-[#2753a4] bg-[#102345]/70 text-[16px] font-medium text-[#5c87ff] shadow-[inset_0_0_17px_rgba(39,83,164,.12)]\" data-kid=\"1-1-7-2-4\" data-name=\"view enhancement button\">\n                    View\n                </button>\n            </article>\n        </section>\n        <nav aria-label=\"Primary navigation\" class=\"absolute bottom-[21px] left-[16px] right-[16px] z-30 h-[85px] rounded-[32px] border border-[#1c334a] bg-[rgba(12,28,45,.92)] px-[8px] shadow-[0_10px_28px_rgba(0,0,0,.25),inset_0_1px_0_rgba(255,255,255,.035)]\" data-kid=\"1-1-8\" data-name=\"main navigation bar\">\n            <div class=\"grid h-full grid-cols-5 items-center\" data-kid=\"1-1-8-1\" data-name=\"navigation button grid\">\n                <button aria-current=\"page\" aria-label=\"Home\" class=\"mx-auto flex h-[61px] w-[61px] flex-col items-center justify-center gap-[3px] rounded-[19px] bg-[#102d5c] text-[#5f96ff]\" data-kid=\"1-1-8-1-1\" data-name=\"home navigation button\">\n                    <i class=\"h-[25px] w-[25px]\" data-dynamic=\"true\" data-kid=\"1-1-8-1-1-1\" data-lucide=\"house\" data-name=\"home icon\" data-reason=\"icon replaced by lucide library\" fill=\"currentColor\" stroke-width=\"1.5\">\n                    </i>\n                    <span class=\"text-[12px] font-medium\" data-kid=\"1-1-8-1-1-2\" data-name=\"home label\">\n                        Home\n                    </span>\n                </button>\n                <button aria-label=\"History\" class=\"mx-auto flex flex-col items-center gap-[4px] text-[#8295ab]\" data-kid=\"1-1-8-1-2\" data-name=\"history navigation button\">\n                    <i class=\"h-[27px] w-[27px]\" data-dynamic=\"true\" data-kid=\"1-1-8-1-2-1\" data-lucide=\"clock-3\" data-name=\"history icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.6\">\n                    </i>\n                    <span class=\"text-[12px]\" data-kid=\"1-1-8-1-2-2\" data-name=\"history label\">\n                        History\n                    </span>\n                </button>\n                <button aria-label=\"Denoise-X\" class=\"relative mx-auto flex flex-col items-center gap-[5px] text-[#d9e5f5]\" data-kid=\"1-1-8-1-3\" data-name=\"denoise-x navigation button\">\n                    <span class=\"absolute -top-[42px] grid h-[70px] w-[70px] place-items-center rounded-full border border-blue-300/30 bg-gradient-to-br from-[#108dff] via-[#3d62ff] to-[#5320d7] shadow-[0_0_24px_rgba(49,116,255,.75)]\" data-kid=\"1-1-8-1-3-1\" data-name=\"denoise-x icon container\">\n                        <i class=\"h-[30px] w-[30px]\" data-dynamic=\"true\" data-kid=\"1-1-8-1-3-1-1\" data-lucide=\"sparkles\" data-name=\"denoise-x sparkles icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.7\">\n                        </i>\n                    </span>\n                    <span class=\"mt-[38px] text-[12px]\" data-kid=\"1-1-8-1-3-2\" data-name=\"denoise-x label\">\n                        Denoise-X\n                    </span>\n                </button>\n                <button aria-label=\"Feedback\" class=\"mx-auto flex flex-col items-center gap-[4px] text-[#8295ab]\" data-kid=\"1-1-8-1-4\" data-name=\"feedback navigation button\">\n                    <i class=\"h-[27px] w-[27px]\" data-dynamic=\"true\" data-kid=\"1-1-8-1-4-1\" data-lucide=\"message-circle\" data-name=\"feedback icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.6\">\n                    </i>\n                    <span class=\"text-[12px]\" data-kid=\"1-1-8-1-4-2\" data-name=\"feedback label\">\n                        Feedback\n                    </span>\n                </button>\n                <button aria-label=\"Profile\" class=\"mx-auto flex flex-col items-center gap-[4px] text-[#8295ab]\" data-kid=\"1-1-8-1-5\" data-name=\"profile navigation button\">\n                    <i class=\"h-[27px] w-[27px]\" data-dynamic=\"true\" data-kid=\"1-1-8-1-5-1\" data-lucide=\"user-round\" data-name=\"profile icon\" data-reason=\"icon replaced by lucide library\" stroke-width=\"1.6\">\n                    </i>\n                    <span class=\"text-[12px]\" data-kid=\"1-1-8-1-5-2\" data-name=\"profile label\">\n                        Profile\n                    </span>\n                </button>\n            </div>\n        </nav>\n    </main>\n</div>\n<script>\n    lucide.createIcons({ attrs: { 'aria-hidden': 'true' } });\n</script>\n",
